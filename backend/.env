DEBUG=True
SECRET_KEY=django-insecure-bost-manifest-dev-secret-key-change-in-prod-123456
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Settings
POSTGRES_DB=bost_manifest_db
POSTGRES_USER=bost_user
POSTGRES_PASSWORD=bost_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MongoDB Settings
MONGO_URI=mongodb://mongodb:27017/
MONGO_DB_NAME=bost_manifest_docs

# CORS - origins allowed to call the API from a browser.
# Must include the Vite dev server or the React app cannot reach the backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
# Note: the anon limit applies to the login endpoint. Raise it if you are
# testing many logins in quick succession.
THROTTLE_ANON_BURST=10/minute
THROTTLE_USER_BURST=60/minute
